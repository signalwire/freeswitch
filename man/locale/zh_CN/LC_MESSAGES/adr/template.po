msgid "Non-Goals"
msgstr "非目标"

#: ../../adr/template.md:37 b5f1293f9a42474ca5af335bcaa30f83
msgid "Non-goal 1: [What we explicitly do NOT want to address]"
msgstr "非目标 1：[我们明确不打算解决什么]"

#: ../../adr/template.md:38 bacb5338b12744e18f9e1020949328d7
msgid "Non-goal 2: [What we explicitly do NOT want to address]"
msgstr "非目标 2：[我们明确不打算解决什么]"

#: ../../adr/template.md:40 93605c409b8046b8a8257234f4b8b9e1
msgid "Decision"
msgstr "决策"

#: ../../adr/template.md:42 a3e6fae5a8b94b50a641f83dca8d0cba
msgid ""
"[Describe the decision that was made. Be specific and clear. Then explain "
"**why this option was chosen over the alternatives** — this is the most "
"valuable sentence in the entire ADR.]"
msgstr "[描述做出的决策。要具体、清楚。然后说明**为什么选择该方案而不是其他备选**——这是整份 ADR 中最有价值的一句。]"

#: ../../adr/template.md:44 839629641ed34c6cabfe4f7517f53bd0
msgid "Summary"
msgstr "摘要"

#: ../../adr/template.md:46 762311663b764f5faf2b4513739c5dc7

"`struct switch_core_session` in `src/include/private/switch_core_pvt.h`; "
"`switch_core_session_request_uuid`"

#: ../../02-architecture.md:144 4dc2abdfc2bf4dd6a82ca4901e8b80bf
msgid "UUID, endpoint pointer, codec pair, event/message queues, media bugs"
msgstr "UUID、端点指针、编解码器对、事件/消息队列、媒体探针"

#: ../../02-architecture.md:144 5be40811b75f4284bad16534773244df
msgid ""
"`switch_channel_t`, `switch_channel_state_t` (`CS_*`), call state `CCS_*`"
msgstr ""
"`switch_channel_t`, `switch_channel_state_t` (`CS_*`), call state `CCS_*`"

#: ../../02-architecture.md:144 0a54f3cc24044b2b9ab4570e05c89644
msgid "Dialplan and apps key off channel state/variables"
msgstr "拨号计划与应用依据通道状态/变量"

#: ../../02-architecture.md:144 c3816b3ecc01428e8f492d5566b84bd6
msgid "Endpoint contract"
msgstr "端点契约"

#: ../../02-architecture.md:144 e23ba5709598428c8ae9b26357fdecd5
msgid "`switch_endpoint_interface_t`, `switch_state_handler_table`"
msgstr "`switch_endpoint_interface_t`, `switch_state_handler_table`"

#: ../../02-architecture.md:144 53a6404df259481f9b0c6de7e282ed63
msgid "Sofia fills `on_init` / `on_routing` / …"
msgstr "Sofia 填充 `on_init` / `on_routing` / …"

#: ../../02-architecture.md:144 f168c2a5ac894cb88c227f88a59196bb
msgid "Module contract"
msgstr "模块契约"

#: ../../02-architecture.md:144 ec70a59d6e4448a1909e64ce320a6f9d

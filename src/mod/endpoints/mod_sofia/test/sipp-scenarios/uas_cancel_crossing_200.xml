<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!--
  UAS for sipp-based-tests.c cancel_crossing_200.
  FreeSWITCH originates to us and we ring. When its CANCEL arrives we answer the CANCEL
  with 200 (RFC 3261 9.2) and then the INVITE with a 200 OK anyway, so the 2xx crosses
  the CANCEL. FreeSWITCH must ACK the 2xx and then BYE the dialog; if either is missing
  a recv times out and sipp exits non-zero.
-->

<scenario name="UAS CANCEL crossing 200">

  <recv request="INVITE">
    <action>
      <ereg regexp="([0-9]+) INVITE" search_in="hdr" header="CSeq:" check_it="true" assign_to="inv_cseq_hdr,inv_cseq" />
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>

  <recv request="CANCEL" timeout="10000" />

  <!-- the reply to the CANCEL goes first: FreeSWITCH ACKs and BYEs a crossing 2xx at once, so an ACK
       arriving while sipp still had a send queued after the 2xx would abort the scenario -->
  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- the 2xx that crosses the CANCEL: CANCEL carries the INVITE's Via, From, To and Call-ID -->
  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      CSeq: [$inv_cseq] INVITE
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000

    ]]>
  </send>

  <recv request="ACK" timeout="5000" />

  <recv request="BYE" timeout="5000" />

  <send>
    <![CDATA[

      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <!-- set only to check or capture: tell sipp they are deliberately not used again -->
  <Reference variables="inv_cseq_hdr" />

  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200"/>
  <CallLengthRepartition value="10, 50, 100, 500, 1000, 5000, 10000"/>
</scenario>

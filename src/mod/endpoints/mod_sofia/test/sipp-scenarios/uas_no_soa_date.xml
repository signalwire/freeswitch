<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<scenario name="UAS checks the Date header of an INVITE sent without the SOA engine">
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="Date: [A-Z][a-z][a-z], [0-9]" search_in="msg" check_it="true" assign_to="date"/>
    </action>
  </recv>

  <send>
    <![CDATA[

      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>

  <recv request="ACK" crlf="true">
  </recv>

  <Reference variables="date"/>
</scenario>

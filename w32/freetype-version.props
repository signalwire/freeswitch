<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <freetypeVersion>2.14.3</freetypeVersion>
    <freetypeBuildNumber>1</freetypeBuildNumber>
  </PropertyGroup>
  <PropertyGroup>
    <freetypeVersionImported>true</freetypeVersionImported>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="freetypeVersion">
      <Value>$(freetypeVersion)</Value>
    </BuildMacro>
    <BuildMacro Include="freetypeBuildNumber">
      <Value>$(freetypeBuildNumber)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <sqliteVersion>3.53.4</sqliteVersion>
    <sqliteBuildNumber>1</sqliteBuildNumber>
  </PropertyGroup>
  <PropertyGroup>
    <sqliteVersionImported>true</sqliteVersionImported>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="sqliteVersion">
      <Value>$(sqliteVersion)</Value>
    </BuildMacro>
    <BuildMacro Include="sqliteBuildNumber">
      <Value>$(sqliteBuildNumber)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <libshoutVersion>2.4.6</libshoutVersion>
    <libshoutBuildNumber>1</libshoutBuildNumber>
  </PropertyGroup>
  <PropertyGroup>
    <libshoutVersionImported>true</libshoutVersionImported>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup />
  <ItemGroup>
    <BuildMacro Include="libshoutVersion">
      <Value>$(libshoutVersion)</Value>
    </BuildMacro>
    <BuildMacro Include="libshoutBuildNumber">
      <Value>$(libshoutBuildNumber)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>
